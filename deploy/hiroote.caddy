{$HIROOTE_DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# لوحة تحكم لا تُؤطَّر في أي إطار — `DENY` أشدّ من `SAMEORIGIN`.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# لوحة إدارة لا تحتاج شيئًا من صلاحيات المتصفح: الإطفاء هو الافتراض.
		Permissions-Policy "geolocation=(), microphone=(), camera=(), display-capture=(), payment=()"
		-Server
	}

	# اسم الحاوية = مشروع compose (`hiroote`) + اسم الخدمة (`app`).
	# والمنفذ ٨٠٨٠ داخليّ لا يُنشر إلى الخارج.
	reverse_proxy hiroote-app-1:8080
}

# `www` تُحوَّل ولا تُخدَم: عنوانان يعرضان اللوحة نفسها يعنيان جلستين وكوكيزًا
# منفصلة، فمن يدخل من أحدهما يجده مطلوبًا للدخول في الآخر.
www.{$HIROOTE_DOMAIN} {
	redir https://{$HIROOTE_DOMAIN}{uri} permanent
}
