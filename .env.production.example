# ═══ بيئة الإنتاج — انسخه إلى .env على الخادم واملأه ═══
#
# لا تُرفع نسخته المملوءة إلى git إطلاقًا. وكل قيمة هنا سرٌّ إلى أن يثبت العكس.

APP_NAME="Hiroote AI"
APP_ENV=production

# ⚠️ ولّده **مرة واحدة** بـ `php artisan key:generate --show` والصقه هنا.
# وتغييرُه لاحقًا يُبطل كل سرٍّ مشفَّر محفوظ: بيانات جسور المشاريع وأسرار توقيع
# التنبيهات — بلا رسالة خطأ، إلى أن يُخفق أول نداء ولا يُعرف السبب.
APP_KEY=

# صفحة الخطأ في وضع التنقيح تكشف الإعداد والمسارات وقيم البيئة لكل زائر.
# ونقطة الدخول ترفض الإقلاع إن كانت `true`.
APP_DEBUG=false

# النطاق كاملًا بـ https — منه تُبنى روابط الأصول وإعادة التوجيه.
APP_URL=https://

APP_LOCALE=ar
APP_TIMEZONE=Asia/Riyadh

# الثقة بالبوّابة مضبوطة في `bootstrap/app.php` على النطاقات الخاصة، لا هنا:
# قيمةٌ أمنية تُقرأ من ملفٍ على الخادم يمكن أن تُفتح على `*` سهوًا.

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=hiroote
DB_USERNAME=hiroote
# كلمة مرور طويلة عشوائية: `openssl rand -base64 32`
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ⚠️ `log` تبتلع الرسالة: «أُرسل» في الكود و«لم يصل» عند المستلم. واللوحة
# **تعرفها** فتعلن قناة البريد «غير مربوطة» بدل أن تدّعي وصولًا لم يقع.
# اضبط مُرسِلًا حقيقيًّا لتصير القناة حيّة — بلا تعديل كود.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="alerts@"
MAIL_FROM_NAME="${APP_NAME}"

# كل كم دقيقة تُقيَّم قواعد التنبيه.
ALERT_EVALUATION_INTERVAL_MINUTES=15

# اسم شبكة موازين على الخادم — منها تصل Caddy حاويةَ هاي روت.
# تحقّق منه بـ: docker network ls | grep app
GATEWAY_NETWORK=mazeen-staging_app
