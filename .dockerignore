# ما لا يدخل صورة الإنتاج.
#
# أخطرها الأول: `COPY . .` مع `.env` موجودًا يخبز أسرار الخادم داخل الصورة —
# فتحملها كل نسخة منها، ويقرؤها من يصل إلى السجلّ أو الطبقات.
.env
.env.*
!.env.example
!.env.production.example

.git
.github
.gitignore
.gitattributes
.gitleaksignore

node_modules
vendor
public/build
public/hot
public/storage

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
!storage/**/.gitignore

tests
phpunit.xml
.phpunit.result.cache
phpstan.neon.dist
pint.json
eslint.config.js
.prettierrc
.editorconfig

docker-compose.yml
docker-compose.prod.yml
Dockerfile*
dump.rdb
