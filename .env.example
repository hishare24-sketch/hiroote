APP_NAME="Hiroote AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hiroote
DB_USERNAME=hiroote
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@hiroote.ai"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# جسر التكامل مع Hi-Share — وثيقة 02 §5
# اتصال صادر فقط عبر REST؛ يمنع الاتصال المباشر بقاعدة بيانات Hi-Share.
# ---------------------------------------------------------------------------
HISHARE_BASE_URL=https://staging.hi-share.example/api/v1
HISHARE_SERVICE_TOKEN=
HISHARE_HMAC_SECRET=
HISHARE_TIMEOUT=10
HISHARE_RETRY_TIMES=2

# ---------------------------------------------------------------------------
# الفحص الذاتي لمزودي الذكاء — وثيقة التصميم §9 (الافتراضي ساعة واحدة)
# ---------------------------------------------------------------------------
AI_HEALTH_CHECK_INTERVAL_MINUTES=60
